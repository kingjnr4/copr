[Desktop Entry]
Type=Application
Name=Eclipse Installer
GenericName=Eclipse IDE Installer
Comment=Choose and install Eclipse IDE packages
Exec=eclipse-installer
Icon=org.eclipse.Installer
Categories=Development;IDE;Java;
Keywords=eclipse;oomph;java;installer;development;
Terminal=false
StartupNotify=true
# SWT uses a non-breaking space (U+00A0) in its Wayland app ID.
StartupWMClass=Eclipse Installer
